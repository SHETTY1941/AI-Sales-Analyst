# Copy this file to .env. Never commit .env or expose API keys in React.
# auto = Gemini first, Groq fallback. Or choose gemini / groq explicitly.
AI_PROVIDER=auto

# Google Gemini API key (recommended primary provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API key (OpenAI-compatible API; used as fallback in auto mode)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional timeout for each model request
AI_TIMEOUT_SECONDS=35

# React frontend backend URL
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional comma-separated deployed frontend origins
CORS_ORIGINS=
